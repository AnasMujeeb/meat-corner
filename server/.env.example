# ─── Server ───────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ─── Database ─────────────────────────────────────────────────────────────────
MONGODB_URI=mongodb://127.0.0.1:27017/meat-corner

# ─── Auth ─────────────────────────────────────────────────────────────────────
JWT_SECRET=change_me_to_a_long_random_string_at_least_32_chars
JWT_EXPIRES_IN=7d

# ─── CORS (single or comma-separated origins) ──────────────────────────────────
CLIENT_URL=http://localhost:5173
ADMIN_URL=http://localhost:5174

# ─── Storage ──────────────────────────────────────────────────────────────────
UPLOAD_DIR=uploads
# Vercel Blob (optional in dev, required on Vercel)
BLOB_READ_WRITE_TOKEN=

# ─── Seed credentials (used by npm run seed only) ─────────────────────────────
ADMIN_EMAIL=admin@meatcorner.qa
ADMIN_PASSWORD=ChangeMe123!
